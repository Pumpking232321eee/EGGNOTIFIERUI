-- Function to clean text from formatting tags
local function CleanText(text)
    local cleaned = text:gsub("<[^>]+>", "")
    cleaned = cleaned:gsub("%s+", " ")
    cleaned = cleaned:match("^%s*(.-)%s*$")
    return cleaned
end

-- Function to check if egg is in the list
local function IsEggInList(rarity, eggName)
    if not EggLists[rarity] then return false end
    
    for _, listItem in ipairs(EggLists[rarity]) do
        if eggName == listItem or string.find(eggName, listItem) or string.find(listItem, eggName) then
            return true
        end
    end
    return false
end

-- Function to check if text contains any rarity and spawn location
local function CheckTextAndSendWebhook()
    if not isEnabled then return end
    
    local gui = Player.PlayerGui
    if not gui then return end
    
    local notifications = gui:FindFirstChild("Notifications")
    if not notifications then return end
    
    local messageTop = notifications:FindFirstChild("MessageTop")
    if not messageTop then return end
    
    local msgNotif = messageTop:FindFirstChild("MsgNotif")
    if not msgNotif then return end
    
    local frame = msgNotif:FindFirstChild("Frame")
    if not frame then return end
    
    local textLabel = frame:FindFirstChild("TextLabel")
    if not textLabel or not textLabel:IsA("TextLabel") then return end
    
    local rawText = textLabel.Text
    if not rawText or rawText == "" then return end
    
    local text = CleanText(rawText)
    
    local foundRarity = nil
    local foundEgg = nil
    local foundLocation = nil
    
    for _, rarity in pairs({"Secret", "Eternal", "Divine"}) do
        if string.find(text, rarity) then
            foundRarity = rarity
            break
        end
    end
    
    if not foundRarity then return end
    
    local fullEggName = nil
    
    local pattern = foundRarity .. "%s+(.-)%s*[Ee]gg"
    local eggMatch = string.match(text, pattern)
    if eggMatch then
        fullEggName = eggMatch .. " Egg"
    else
        local altPattern = foundRarity .. "%s+(.-)%s*[Ee]gg%s"
        local altMatch = string.match(text, altPattern)
        if altMatch then
            fullEggName = altMatch .. " Egg"
        else
            local simpleMatch = string.match(text, foundRarity .. "%s+(.-)[Ee]gg")
            if simpleMatch then
                fullEggName = simpleMatch .. " Egg"
            else
                fullEggName = "Unknown Egg"
            end
        end
    end
    
    if not IsEggInList(foundRarity, fullEggName) then
        return
    end
    
    for _, location in ipairs(SpawnLocations) do
        if string.find(text, location) then
            foundLocation = location
            break
        end
    end
    
    if not foundLocation then
        local locationMatch = string.match(text, "in%s+([%w%s]+)[!%.]")
        if locationMatch then
            foundLocation = locationMatch
        else
            foundLocation = "Unknown Location"
        end
    end
    
    local cleanContent = "A " .. foundRarity .. " " .. fullEggName .. " spawned in " .. foundLocation
    
    local OSTime = os.time()
    local Time = os.date('!*t', OSTime)
    
    local Content = "🚨 " .. foundRarity .. " **" .. fullEggName .. "** Spawned at " .. foundLocation .. "!"
    local color = RarityColors[foundRarity] or 0xFFFFFF
    
    local Embed = {
        title = "**" .. fullEggName .. "** Spawned!";
        color = color;
        fields = {
            {
                name = "Rarity";
                value = foundRarity;
                inline = true;
            };
            {
                name = "Egg";
                value = fullEggName;
                inline = true;
            };
            {
                name = "Spawned At";
                value = foundLocation;
                inline = true;
            };
            {
                name = "Message";
                value = cleanContent;
                inline = false;
            };
        };
        footer = { 
            text = "Server JobId: " .. game.JobId .. " | Egg Alert System";
        };
        timestamp = string.format('%d-%d-%dT%02d:%02d:%02dZ', Time.year, Time.month, Time.day, Time.hour, Time.min, Time.sec);
    };
    
    local request = syn and syn.request or http_request
    if request then
        request({
            Url = WebhookURL;
            Method = 'POST';
            Headers = {
                ['Content-Type'] = 'application/json';
            };
            Body = HttpService:JSONEncode({
                content = Content .. ' <@' .. DiscordID .. '>';
                embeds = { Embed };
                username = "Steal an Egg Notifier";
                avatar_url = Avatar;
                allowed_mentions = {
                    users = { DiscordID };
                };
            });
        });
    end
end

-- Function to create the GUI
local function CreateGUI()
    -- Create ScreenGui
    local screenGui = Instance.new("ScreenGui")
